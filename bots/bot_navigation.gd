class_name BotNavigation
extends Node3D
## Bot navigation for any map (PLAN §2.7): the navmesh is baked at runtime
## from the map's gameplay collision, and traversal links are generated by
## probing the navmesh's open edges for ledges our movement can climb
## (mantle, double jump + mantle) and drops, plus one-way links over the
## map's jump pads. Each link carries the traversal it needs, so maps need
## no hand-placed bot data.

enum Traversal { NONE, JUMP_MANTLE, DOUBLE_JUMP_MANTLE, DROP, PAD }

## Multiples of CELL (Recast rounds otherwise).
const AGENT_RADIUS := 0.5
const AGENT_HEIGHT := 1.75
const AGENT_CLIMB := 0.25
const CELL := 0.25
const MANTLE_MAX := 1.9  ## jump + mantle (MovementConfig mantles up to ~1.8 m above the feet)
const DOUBLE_JUMP_MANTLE_MAX := 3.3
const MIN_STEP := 0.4  ## smaller height changes are walked (ramps, steps)
const MAX_DROP := 6.0
const PROBE_SPACING := 1.0
const PROBE_REACH := [0.7, 1.2, 1.7]
const LINK_MIN_SPACING := 2.0

var navmesh := NavigationMesh.new()
var links: Array[NavigationLink3D] = []
var ready_for_queries: bool = false

var _region: NavigationRegion3D
var _space: PhysicsDirectSpaceState3D


## Bakes from the colliders under `gameplay` and generates traversal links.
## Call after the map's bodies are in the physics space (one physics frame).
func build(gameplay: Node3D) -> void:
	navmesh.agent_radius = AGENT_RADIUS
	navmesh.agent_height = AGENT_HEIGHT
	navmesh.agent_max_climb = AGENT_CLIMB
	navmesh.agent_max_slope = 40.0
	navmesh.cell_size = CELL
	navmesh.cell_height = CELL
	navmesh.geometry_parsed_geometry_type = NavigationMesh.PARSED_GEOMETRY_STATIC_COLLIDERS
	navmesh.geometry_collision_mask = Sim.LAYER_WORLD
	var source := NavigationMeshSourceGeometryData3D.new()
	NavigationServer3D.parse_source_geometry_data(navmesh, source, gameplay)
	NavigationServer3D.bake_from_source_geometry_data(navmesh, source)
	NavigationServer3D.map_set_cell_size(get_world_3d().navigation_map, CELL)
	NavigationServer3D.map_set_cell_height(get_world_3d().navigation_map, CELL)
	_region = NavigationRegion3D.new()
	_region.navigation_mesh = navmesh
	add_child(_region)
	_space = get_world_3d().direct_space_state
	# The navigation map syncs on physics frames: once for the region (link
	# generation queries it), once more for the links.
	var verts := navmesh.get_vertices()
	if verts.is_empty():
		push_warning("BotNavigation: empty navmesh")
		return
	await _wait_until_queryable(verts[0])
	_generate_links()
	if gameplay.has_method("jump_pads"):
		for pad: Dictionary in gameplay.jump_pads():
			_add_pad_link(pad)
	await _map_synced()
	ready_for_queries = true


## Until the map answers queries near a point of our navmesh.
func _wait_until_queryable(p: Vector3) -> void:
	for i in 60:
		await get_tree().physics_frame
		if NavigationServer3D.map_get_iteration_id(map()) > 0 and closest_point(p).distance_to(p) < 0.5:
			return
	push_warning("BotNavigation: navigation map didn't sync")


func _map_synced() -> void:
	var before := NavigationServer3D.map_get_iteration_id(map())
	for i in 30:
		await get_tree().physics_frame
		if NavigationServer3D.map_get_iteration_id(map()) != before:
			return


func map() -> RID:
	return get_world_3d().navigation_map


## Path from `from` to `to`: Array of [Vector3 point, Traversal to reach the
## next point]. Empty if there's no path.
func path(from: Vector3, to: Vector3) -> Array:
	if not ready_for_queries:
		return []
	var params := NavigationPathQueryParameters3D.new()
	params.map = map()
	params.start_position = from
	params.target_position = to
	params.metadata_flags = NavigationPathQueryParameters3D.PATH_METADATA_INCLUDE_TYPES \
			| NavigationPathQueryParameters3D.PATH_METADATA_INCLUDE_OWNERS
	var result := NavigationPathQueryResult3D.new()
	NavigationServer3D.query_path(params, result)
	var points := result.path
	var types := result.path_types
	var owners := result.path_owner_ids
	var out := []
	for i in points.size():
		var traversal := Traversal.NONE
		# A link segment starts at a point whose type is LINK; its owner is the link node.
		if i < types.size() and types[i] == NavigationPathQueryResult3D.PATH_SEGMENT_TYPE_LINK:
			var link := instance_from_id(owners[i]) as NavigationLink3D
			if link != null:
				traversal = link.get_meta("traversal", Traversal.NONE)
		out.append([points[i], traversal])
	return out


func random_point() -> Vector3:
	return NavigationServer3D.map_get_random_point(map(), 1, true)


func closest_point(p: Vector3) -> Vector3:
	return NavigationServer3D.map_get_closest_point(map(), p)


# --- Link generation ---

func _generate_links() -> void:
	var verts := navmesh.get_vertices()
	var edge_count := {}
	var polys := []
	for i in navmesh.get_polygon_count():
		var poly := navmesh.get_polygon(i)
		polys.append(poly)
		for j in poly.size():
			var key := _edge_key(poly[j], poly[(j + 1) % poly.size()])
			edge_count[key] = edge_count.get(key, 0) + 1
	var placed: Array[Vector3] = []
	for poly: PackedInt32Array in polys:
		var center := Vector3.ZERO
		for idx in poly:
			center += verts[idx]
		center /= poly.size()
		for j in poly.size():
			var a := verts[poly[j]]
			var b := verts[poly[(j + 1) % poly.size()]]
			if edge_count[_edge_key(poly[j], poly[(j + 1) % poly.size()])] != 1:
				continue  # inner edge
			var along := b - a
			var length := Vector2(along.x, along.z).length()
			if length < 0.3:
				continue
			# Outward normal: away from the polygon centre.
			var normal := Vector3(along.z, 0.0, -along.x).normalized()
			if normal.dot((a + b) * 0.5 - center) < 0.0:
				normal = -normal
			var samples := maxi(1, int(length / PROBE_SPACING))
			for s in samples:
				var p := a.lerp(b, (s + 0.5) / samples)
				_probe(p, normal, placed)


func _probe(edge_point: Vector3, normal: Vector3, placed: Array[Vector3]) -> void:
	for p in placed:
		if p.distance_to(edge_point) < LINK_MIN_SPACING:
			return
	for reach: float in PROBE_REACH:
		var probe := edge_point + normal * (reach + AGENT_RADIUS)
		var landing: Variant = _ground(probe, edge_point.y + DOUBLE_JUMP_MANTLE_MAX + 0.5)
		if landing == null:
			continue
		var target := closest_point(landing)
		# The navmesh floats about two cells above the geometry.
		if Vector2(target.x - landing.x, target.z - landing.z).length() > 0.6 or absf(target.y - landing.y) > 0.8:
			continue
		var dh: float = target.y - edge_point.y
		var traversal := Traversal.NONE
		if dh > MIN_STEP and dh <= MANTLE_MAX:
			traversal = Traversal.JUMP_MANTLE
		elif dh > MANTLE_MAX and dh <= DOUBLE_JUMP_MANTLE_MAX:
			traversal = Traversal.DOUBLE_JUMP_MANTLE
		elif dh < -MIN_STEP and dh >= -MAX_DROP:
			traversal = Traversal.DROP
		if traversal == Traversal.NONE:
			continue
		if traversal != Traversal.DROP and not _clear_above(edge_point, target):
			continue
		_add_link(edge_point, target, traversal)
		placed.append(edge_point)
		return


## Highest walkable surface under `p`, casting down from `top`.
func _ground(p: Vector3, top: float) -> Variant:
	var from := Vector3(p.x, top, p.z)
	var hit := _space.intersect_ray(PhysicsRayQueryParameters3D.create(from, Vector3(p.x, p.y - MAX_DROP - 0.5, p.z), Sim.LAYER_WORLD))
	if hit.is_empty() or hit.normal.y < 0.7:
		return null
	return hit.position


## Room to jump: nothing between head height at the start and the landing.
func _clear_above(from: Vector3, to: Vector3) -> bool:
	var top := maxf(from.y, to.y) + AGENT_HEIGHT
	var a := Vector3(from.x, top, from.z)
	var b := Vector3(to.x, top, to.z)
	return _space.intersect_ray(PhysicsRayQueryParameters3D.create(a, b, Sim.LAYER_WORLD)).is_empty() \
			and _space.intersect_ray(PhysicsRayQueryParameters3D.create(from + Vector3.UP * 0.3, a, Sim.LAYER_WORLD)).is_empty()


func _add_link(from: Vector3, to: Vector3, traversal: int) -> void:
	var link := NavigationLink3D.new()
	link.bidirectional = false
	link.start_position = from
	link.end_position = to
	link.set_meta("traversal", traversal)
	add_child(link)
	links.append(link)
	# Drops are cheap to take; climbs a little dearer than walking around.
	link.travel_cost = 1.0 if traversal == Traversal.DROP else 1.5
	if traversal != Traversal.DROP:
		# Every climb can also be dropped down.
		var down := NavigationLink3D.new()
		down.bidirectional = false
		down.start_position = to
		down.end_position = from
		down.set_meta("traversal", Traversal.DROP)
		add_child(down)
		links.append(down)


## A pad throws you to its target: a cheap one-way link from its centre.
func _add_pad_link(pad: Dictionary) -> void:
	var link := NavigationLink3D.new()
	link.bidirectional = false
	link.start_position = closest_point(pad.position)
	link.end_position = closest_point(pad.target)
	link.set_meta("traversal", Traversal.PAD)
	link.travel_cost = 0.5
	add_child(link)
	links.append(link)


static func _edge_key(i: int, j: int) -> int:
	return mini(i, j) * 1000003 + maxi(i, j)
