extends Node
## Version and compatibility identifiers (PLAN §3.14).
##
## `res://build_info.json` is generated by `tools/write_build_info.py` before
## every export. Editor runs fall back to development values.

const PATH := "res://build_info.json"

var version: String = "0.0.0-dev"
var artifact_id: String = "dev"
var git_hash: String = "unknown"
var compat_hash: String = "dev"
var protocol_version: int = 1
var engine_version: String = ""


func _ready() -> void:
	engine_version = "%s.%s.%s-%s" % [
		Engine.get_version_info().major,
		Engine.get_version_info().minor,
		Engine.get_version_info().patch,
		Engine.get_version_info().status,
	]
	if not FileAccess.file_exists(PATH):
		version = str(ProjectSettings.get_setting("application/config/version", version)) + "-dev"
		return
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(PATH))
	if data is Dictionary:
		version = data.get("version", version)
		artifact_id = data.get("artifact_id", artifact_id)
		git_hash = data.get("git_hash", git_hash)
		compat_hash = data.get("compat_hash", compat_hash)
		protocol_version = int(data.get("protocol_version", protocol_version))


## Short human-readable string, e.g. "0.0.1 (abc1234)".
func display_string() -> String:
	return "%s (%s)" % [version, git_hash.substr(0, 7)]
